  object dsSangria: TWiFDQuery
    MasterSource = doResumoCaixa
    MasterFields = 'pcxo_id'
    DetailFields = 'pcxo_id'
    Connection = FrmPDV_DModule.ADConnection1
    FetchOptions.AssignedValues = [evCache]
    FetchOptions.Cache = [fiBlobs, fiMeta]
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      'SELECT  b.pcxov_id ,'
      '        b.pcxov_data ,'
      '        d.pterm_numero ,'
      '        d.pterm_descricao ,'
      '        b.pcxov_valor ,'
      '        ( SELECT    us_apelido'
      '          FROM      dbo.t_users x'
      '          WHERE     x.us_codigo = a.us_codigo ) AS us_operador ,'
      '        ( SELECT    us_apelido'
      '          FROM      dbo.t_users x'
      
        '          WHERE     x.us_codigo = a.us_codigo_supervisor ) AS us' +
        '_supervisor'
      'FROM    pdv.tb_caixa_operador a'
      
        '        INNER JOIN pdv.tb_caixa_operador_valores b ON b.pcxo_id ' +
        '= a.pcxo_id'
      '        INNER JOIN pdv.tb_caixa c ON c.pcx_id = a.pcx_id'
      '        INNER JOIN pdv.tb_terminais d ON d.pterm_id = c.pterm_id'
      'WHERE   a.pcxo_id = :pcxo_id AND'
      '        pcxov_trans_id = :pcxov_trans_id AND'
      '        b.pcxov_sangria = 1'
      'ORDER BY a.pcxo_id DESC;'
      ''
      '')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 808
    Top = 96
    ParamData = <
      item
        Name = 'PCXO_ID'
        DataType = ftAutoInc
        ParamType = ptInput
        Value = 23
      end
      item
        Name = 'PCXOV_TRANS_ID'
        ParamType = ptInput
      end>
  end
