  object fdPagamentosAll: TWiFDQuery
    Connection = FrmPDV_DModule.ADConnection1
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      'SELECT  a.* ,'
      '        c.pnf_chave ,'
      '        c.pnf_numero_fiscal'
      'FROM    pdv.tb_nota_fiscal_pag a'
      
        '        INNER JOIN dbo.t_formaspag b ON b.fp_codigo = a.fp_codig' +
        'o AND'
      '                                        b.fp_cartao = 1'
      '        INNER JOIN pdv.tb_nota_fiscal c ON c.pnf_id = a.pnf_id'
      'WHERE   ISNULL(pnfp_pos_id_local, 0) > 0;')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 36
    Top = 252
  end
  object fdPagamentos: TWiFDQuery
    Connection = FrmPDV_DModule.ADConnection1
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      'SELECT  a.*'
      'FROM    pdv.tb_nota_fiscal_pag a'
      
        '        INNER JOIN dbo.t_formaspag b ON b.fp_codigo = a.fp_codig' +
        'o AND'
      '                                        b.fp_cartao = 1'
      'WHERE   pnf_id = :pnf_id AND'
      '        ISNULL(pnfp_pos_id_local, 0) = 0;')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 28
    Top = 316
    ParamData = <
      item
        Name = 'PNF_ID'
        DataType = ftInteger
        ParamType = ptInput
      end>
  end
  object dsVendasPags: TWiFDQuery
    MasterSource = doVendas
    MasterFields = 'pnf_id'
    DetailFields = 'pnf_id'
    Connection = FrmPDV_DModule.ADConnection1
    FetchOptions.AssignedValues = [evCache]
    FetchOptions.Cache = [fiBlobs, fiMeta]
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      ''
      
        'SELECT * FROM (SELECT pnfp_forma_pag,ISNULL(pnfp_valor,0)AS pnfp' +
        '_valor FROM pdv.tb_nota_fiscal_pag  where pnf_id =:pnf_id'
      'UNION ALL'
      
        'SELECT '#39'TROCO'#39',pnf_troco FROM pdv.tb_nota_fiscal WHERE pnf_id =:' +
        'pnf_id) t WHERE pnfp_valor>0')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 584
    Top = 104
    ParamData = <
      item
        Name = 'PNF_ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
