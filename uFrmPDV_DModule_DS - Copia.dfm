  object dsVendasItensConsumo: TWiFDQuery
    Connection = FrmPDV_DModule.ADConnection1
    FetchOptions.AssignedValues = [evCache]
    FetchOptions.Cache = [fiBlobs, fiMeta]
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      'SELECT  pnfi_id_comanda'
      'FROM    pdv.tb_nota_fiscal_itens'
      'WHERE   pnf_id = :pnf_id AND'
      '        ISNULL(pnfi_id_comanda, 0) > 0'
      'GROUP BY pnfi_id_comanda;')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 564
    Top = 244
    ParamData = <
      item
        Name = 'PNF_ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
  end
