  object dsItensDelete: TWiFDQuery
    Connection = FrmPDV_DModule.ADConnection1
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      
        'SELECT  ( ROW_NUMBER() OVER ( PARTITION BY pnf_id ORDER BY pnfi_' +
        'id ) ) AS item ,'
      '        pr_codigo ,'
      '        pnfi_ean ,'
      '        pnfi_produto_descr ,'
      '        un_sigla ,'
      '        pnfi_id ,'
      '        pnfi_qtd ,'
      '        pnfi_valor_unit ,'
      '        pnfi_valor_total ,'
      '        pnfi_cancelado'
      'FROM    pdv.tb_nota_fiscal_itens'
      'WHERE '
      #9' pnf_id = :pnf_id')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 28
    Top = 188
    ParamData = <
      item
        Name = 'PNF_ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = 33
      end>
  end
  object fdNotas: TWiFDQuery
    Connection = FrmPDV_DModule.ADConnection1
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      'SELECT  pnf_id ,'
      '        pnf_serie ,'
      '        pnf_numero_fiscal ,'
      '        pnf_data_emissao ,'
      '        pnf_volumes ,'
      '        pnf_total_nota ,'
      '        en_cnpjcpf ,'
      '        en_nome_completo ,'
      '        pnf_sat ,'
      '        pnf_nfce ,'
      '        pnf_status ,'
      '        dbo.GetStatusNFe(pnf_status) AS pnf_status_str ,'
      '        pnf_data_autorizacao ,'
      '        pnf_xml,'
      'pnf_offline,'
      'pnf_motivo_rejeicao'
      'FROM    pdv.vw_nota_fiscal'
      'WHERE   em_codigo = :em_codigo AND'
      '        pnf_offline = :pnf_offline AND'
      '        pnf_data_emissao = CONVERT(VARCHAR, GETDATE(), 112)'
      'ORDER BY pnf_id DESC;')
    CustomDelete = False
    ShowMsgBeforeDelete = False
    ReadOnly = False
    Left = 24
    Top = 120
    ParamData = <
      item
        Name = 'EM_CODIGO'
        DataType = ftInteger
        ParamType = ptInput
        Value = '1'
      end
      item
        Name = 'PNF_OFFLINE'
        ParamType = ptInput
      end>
  end
