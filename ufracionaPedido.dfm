  object a1: TADOQuery
    Connection = ADOConnection1
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'select i.Controle,  PrecoReal/qtd as Preco, produto as CodProdut' +
        'o,p.Descricao,u.ABREDESCRICAO AS Unidade,qtd,precoreal as Total'
      'from inotasai i'
      'join produtos p on p.codigo=i.produto  '
      'join estoque e on e.e_produto=p.codigo  AND E.E_LOJA=1'
      'LEFT JOIN UNIVENDAS U ON U.CODIGO=P.E_UNIDADE'
      'where pedido = 10295 AND I.E_LOJA=1 --AND I.Qtd>0'
      'order by p.descricao')
    Left = 612
    Top = 128
  end
  object itens: TADOQuery
    AutoCalcFields = False
    Connection = ADOConnection1
    CursorType = ctStatic
    OnCalcFields = itensCalcFields
    Parameters = <>
    SQL.Strings = (
      
        'select i.ID,  IDprod as CodProduto,p.Descricao,u.ABREDESCRICAO A' +
        'S Unidade,I.QUANTI,I.QUANTI*I.PRECO as Total,convert(decimal(18,' +
        '2),i.preco) AS Preco,'
      'i.USADO ,i.PENDE,I.PRNOV, e.estoquef,clfiscal'
      'from IFISCALNFCE i  '
      'join produtos p on p.codigo=i.IDPROD  '
      'join estoque e on e.e_produto=p.codigo  AND E.E_LOJA=1'
      'LEFT JOIN UNIVENDAS U ON U.CODIGO=P.E_UNIDADE'
      'where IDpedi= 10448   --AND I.Qtd>0'
      'ORDER BY NEWID()')
    Left = 144
    Top = 128
