  object mem_sql_users: TMemo
    Left = 168
    Top = 175
    Width = 185
    Height = 89
    Lines.Strings = (
      'SELECT'
      '    a.us_codigo ,'
      '    a.us_apelido ,'
      '    a.us_nome ,'
      '  ( SELECT TOP 1'
      '        x.aut_historico'
      '      FROM'
      '        t_autorizacao x'
      '      WHERE'
      '        x.us_codigo = @us_codigo AND'
      '        ISNULL(x.aut_autorizado, 0) = 0 AND'
      '        ISNULL(x.aut_negado, 0) = 0 AND'
      '        x.pm_id = b.pm_id) AS _hist,'
      '    ( SELECT TOP 1'
      '        y.autu_data'
      '      FROM'
      '        t_autorizacao x ,'
      '        t_autorizacao_users y'
      '      WHERE'
      '        x.aut_id = y.aut_id AND'
      '        x.us_codigo = @us_codigo AND'
      '        ISNULL(x.aut_autorizado, 0) = 0 AND'
      '        ISNULL(x.aut_negado, 0) = 0 AND'
      '        x.pm_id = b.pm_id AND'
      '        y.us_codigo = a.us_codigo'
      '      ORDER BY'
      '        x.aut_id DESC ) AS _data ,'
      '    ( SELECT TOP 1'
      '       y.autu_hora'
      '      FROM'
      '        t_autorizacao x ,'
      '        t_autorizacao_users y'
      '      WHERE'
      '        x.aut_id = y.aut_id AND'
      '        x.us_codigo = @us_codigo AND'
      '        ISNULL(x.aut_autorizado, 0) = 0 AND'
      '        ISNULL(x.aut_negado, 0) = 0 AND'
      '        x.pm_id = b.pm_id AND'
      '        y.us_codigo = a.us_codigo'
      '      ORDER BY'
      '        x.aut_id DESC ) AS _hora'
      'FROM'
      '    t_users a ,'
      '    t_users_param b'
      'WHERE'
      '    a.us_codigo = b.us_codigo AND'
      '    b.pm_id = @pm_id and'
      '    b.pm_valor = '#39'1'#39
      '')
    TabOrder = 4
    Visible = False
    WordWrap = False
  end
  object doUsers: TDataSource
    AutoEdit = False
    DataSet = cdsUsers
    Left = 152
    Top = 109
  end
  object cdsUsers: TWiFDQuery
    ConnectionName = 'SimERPConn'
    UpdateOptions.AssignedValues = [uvEDelete, uvEInsert, uvEUpdate]
    SQL.Strings = (
      
        'Select *,'#39'01/01/2000'#39' as autu_data,'#39'00:00:00'#39' as autu_hora from ' +
        't_users order by us_apelido')
    CommandText = 
      'Select *,'#39'01/01/2000'#39' as autu_data,'#39'00:00:00'#39' as autu_hora from ' +
      't_users order by us_apelido'
    CustomDelete = False
    MsgBeforeDelete = 'Confirmar exclus'#227'o do registro?'
    MsgTitleBeforeDelete = 'Confirma'#231#227'o'
    ShowMsgBeforeDelete = True
    ReadOnly = False
    Left = 216
    Top = 133
  end
